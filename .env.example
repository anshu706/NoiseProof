# ── Gnani AI Credentials ──────────────────────────────────────────────────────
# Both STT (Prisma v2.5) and TTS (Timbre v2.5) use the same key.
# Obtain from https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here

# ── Evon (LLM) ────────────────────────────────────────────────────────────────
# Evon v3.3 can be accessed via:
# 1) Hugging Face Inference API: set EVON_API_KEY=hf_... (starts with hf_)
#    Model: gnani/gnani-evon-v3.3-30B-A3B
# 2) Gnani vachana.ai gateway: set EVON_API_KEY=your_gnani_key (or leave blank to use GNANI_API_KEY)
EVON_API_KEY=your_evon_api_key_or_hf_token_here

# ── Safety caps ───────────────────────────────────────────────────────────────
# Hard stop after this many real API calls (prevents accidental credit burn).
MAX_API_CALLS=200

# ── Experiment size ───────────────────────────────────────────────────────────
NUM_BASE_CALLS=6
SNR_LEVELS=clean,20,10,5,0
NOISE_TYPES=street,crowd,wind,white,market

# ── Development ───────────────────────────────────────────────────────────────
# Set DRY_RUN=true to use mocked responses – no API credits consumed.
DRY_RUN=false

# ── App settings ──────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173